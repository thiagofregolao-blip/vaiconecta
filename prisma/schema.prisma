generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  STORE_ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  ACTIVE
  EXPIRED
  CANCELLED
}

model Admin {
  id        String    @id @default(cuid())
  username  String    @unique
  name      String?
  email     String?   @unique
  password  String
  role      AdminRole @default(STORE_ADMIN)
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id])
  createdAt DateTime  @default(now())
}

model Store {
  id            String        @id @default(cuid())
  name          String
  commissionPct Float         @default(10)
  admins        Admin[]
  accessPoints  AccessPoint[]
  createdAt     DateTime      @default(now())
}

model AccessPoint {
  id        String   @id @default(cuid())
  name      String
  apMac     String?  @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())
}

model Plan {
  id         String    @id @default(cuid())
  name       String
  price      Float
  hours      Int
  maxDevices Int       @default(1)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  payments Payment[]
  vouchers Voucher[]
}

model Payment {
  id              String        @id @default(cuid())
  planId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  macAddress      String
  deviceIp        String?
  apMac           String?
  email           String
  status          PaymentStatus @default(PENDING)
  mpPaymentId     String?       @unique
  pixQrCode       String?
  pixQrCodeBase64 String?
  startedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([macAddress])
  @@index([mpPaymentId])
  @@index([apMac])
}

model Voucher {
  id        String    @id @default(cuid())
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id])
  code      String    @unique
  usedBy    String?
  createdBy String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
